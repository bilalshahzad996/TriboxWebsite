# Contact form delivery. Copy this file to .env and fill in, then rebuild (npm run build).
# Without VITE_CONTACT_ENDPOINT the form opens the visitor's email app instead.
#
# Option A — Web3Forms (free): get an access key for sales@tribox365.com at https://web3forms.com
# VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
# VITE_CONTACT_ACCESS_KEY=your-access-key
#
# Option B — Formspree: create a form at https://formspree.io and use its endpoint (no access key)
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/yourFormId

VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
